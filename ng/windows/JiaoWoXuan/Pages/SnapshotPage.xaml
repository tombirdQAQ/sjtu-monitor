<Page
    x:Class="JiaoWoXuan.Pages.SnapshotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JiaoWoXuan"
    xmlns:core="using:JiaoWoXuan.Core">

    <Grid Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="监控快照" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <SelectorBar x:Name="FilterBar" HorizontalAlignment="Right" SelectionChanged="OnFilterChanged">
                <SelectorBarItem Text="仅当前监控" Tag="Watched" />
                <SelectorBarItem Text="仅有空位" Tag="Open" />
                <SelectorBarItem Text="全部" Tag="All" />
            </SelectorBar>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,0" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="方案" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="课程" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="已选 / 容量" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource ColumnHeader}" />
                </Grid>
                <ListView x:Name="Rows" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:StateRow">
                            <Grid ColumnSpacing="10" Padding="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" /><ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7B3;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Visibility="{x:Bind local:Ui.Show(Watched)}" ToolTipService.ToolTip="当前监控目标" />
                                <TextBlock Grid.Column="1" Text="{x:Bind GroupText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind SeatText}" VerticalAlignment="Center" />
                                <local:StatusBadge Grid.Column="4" Text="{x:Bind StatusText}" Tone="{x:Bind StatusTone}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="Empty" Grid.Row="1" Text="没有快照数据：运行一次监控后这里会显示各教学班的余量"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
