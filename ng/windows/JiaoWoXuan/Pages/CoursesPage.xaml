<Page
    x:Class="JiaoWoXuan.Pages.CoursesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JiaoWoXuan"
    xmlns:pages="using:JiaoWoXuan.Pages"
    xmlns:core="using:JiaoWoXuan.Core">

    <Grid Padding="16,8,16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PlanRow" Height="340" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- 学期 -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="TermLabel" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <local:StatusBadge x:Name="TermBadge" />
            <TextBlock x:Name="SiteText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <Button Style="{StaticResource PillButton}" x:Name="SwitchTermButton" Content="切换到教务当前学期" Visibility="Collapsed" Click="OnSwitchTerm" />
            <DropDownButton x:Name="HistoryButton" Visibility="Collapsed" ToolTipService.ToolTip="历史学期仅供参考；只有教务网站当前学期能抓到数据">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="HistoryFlyout" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索课程、教师、编号、时间或地点" QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="130" SelectionChanged="OnFilterChanged" />
            <ToggleButton x:Name="OnlyOpenToggle" Grid.Column="3" Content="有空位" Click="OnFilterToggled" />
            <ToggleButton x:Name="OnlyUnassignedToggle" Grid.Column="4" Content="未分配" Click="OnFilterToggled" />
            <ToggleButton x:Name="MultiSelectToggle" Grid.Column="5" HorizontalAlignment="Left" Click="OnMultiSelectToggled"
                          ToolTipService.ToolTip="进入多选模式：点击即可勾选多门课程，再批量加入方案">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE762;" FontSize="14" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>
            <TextBlock x:Name="CountText" Grid.Column="6" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <DropDownButton Grid.Column="7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <TextBlock Text="同步" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="SyncCatalogItem" Text="获取全量课程" Click="OnSyncCatalog" />
                        <MenuFlyoutItem x:Name="SyncRatingsItem" Text="获取全部评价" Click="OnSyncRatings" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="DetectTermItem" Text="读取教务当前学期" Click="OnDetectTerm" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="InspectorToggle" Grid.Column="8" IsChecked="True" ToolTipService.ToolTip="显示或隐藏课程详情" Click="OnInspectorToggled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                    <TextBlock Text="详情" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- 课程目录 + 详情 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0,16,0" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HeaderTitle" Tag="Title" Content="课程" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="1" x:Name="HeaderTeachers" Tag="Teachers" Content="教师" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="2" x:Name="HeaderSchedule" Tag="Schedule" Content="时间" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="3" x:Name="HeaderKch" Tag="Kch" Content="课程号" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="4" x:Name="HeaderSeats" Tag="Seats" Content="容量" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="5" x:Name="HeaderStatus" Tag="Status" Content="状态" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="6" x:Name="HeaderRating" Tag="Rating" Content="评分" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                        <Button Grid.Column="7" x:Name="HeaderGroup" Tag="Group" Content="方案" Style="{StaticResource ColumnHeaderButton}" Click="OnHeaderClick" />
                    </Grid>
                    <ListView x:Name="CourseList" Grid.Row="1" SelectionMode="Extended" IsItemClickEnabled="False"
                              SelectionChanged="OnCourseSelectionChanged" DoubleTapped="OnCourseDoubleTapped">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="OnCourseMenuOpening">
                                <MenuFlyoutItem x:Name="AddToGroupItem" Text="加入当前方案" Click="OnAddSelected">
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Enter" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="复制课程号" Click="OnCopyKch" />
                                <MenuFlyoutItem Text="复制教学班 ID" Click="OnCopyJxb" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:CourseRow">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ClassName}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Teachers}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FirstSchedule}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind ScheduleText}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind KchText}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind SeatText}" VerticalAlignment="Center" />
                                    <local:StatusBadge Grid.Column="5" Text="{x:Bind StatusText}" Tone="{x:Bind StatusTone}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind RatingText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind GroupText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyCourses" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="Inspector" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer Padding="16">
                    <StackPanel x:Name="InspectorPanel" Spacing="14" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 方案栏 -->
        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="GroupTabs" SelectionMode="Single" SelectionChanged="OnGroupTabChanged" Padding="0"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="MinWidth" Value="140" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:GroupTab">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,2,6,2">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SecondaryText}" MaxWidth="200" />
                            </StackPanel>
                            <local:StatusBadge Text="{x:Bind ConflictText}" Tone="Danger" />
                            <local:StatusBadge Text="{x:Bind FatalText}" Tone="Danger" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Style="{StaticResource PillButton}" Grid.Column="1" Content="新建方案">
                <Button.Flyout>
                    <Flyout x:Name="NewGroupFlyout">
                        <StackPanel Spacing="10" Width="240">
                            <TextBlock Text="新建选课方案" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="NewGroupName" PlaceholderText="例如：大学物理" KeyDown="OnNewGroupKeyDown" />
                            <Button Content="创建" Style="{StaticResource AccentPillButton}" HorizontalAlignment="Right" Click="OnCreateGroup" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Style="{StaticResource PillButton}" x:Name="RevertButton" Grid.Column="2" Content="放弃修改" Click="OnRevert" />
            <Button x:Name="SaveButton" Grid.Column="3" Content="保存方案" Style="{StaticResource AccentPillButton}" Click="OnSave" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid x:Name="PlanEditor" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="PriorityList" SelectionMode="Extended" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              DragItemsCompleted="OnPriorityReordered" SelectionChanged="OnMemberSelectionChanged" KeyDown="OnPriorityKeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:PriorityItem">
                                <Grid ColumnSpacing="12" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Index}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind NoteVisibility}" />
                                    </StackPanel>
                                    <local:StatusBadge Grid.Column="2" Text="{x:Bind BadgeText}" Tone="{x:Bind BadgeTone}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyPlan" Text="方案为空：从上方目录双击或右键加入教学班；优先级从上到下，当前持有固定在末尾"
                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="8" Padding="16" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <CheckBox x:Name="PeCheck" Content="体育课方案" Click="OnPeToggled" />
                        <Button Style="{StaticResource PillButton}" x:Name="AddSelectedButton" HorizontalAlignment="Stretch" Click="OnAddSelected" />
                        <MenuFlyoutSeparator />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PillButton}" x:Name="MoveUpButton" HorizontalAlignment="Stretch" ToolTipService.ToolTip="上移" Click="OnMoveUp"><FontIcon Glyph="&#xE70E;" FontSize="14" /></Button>
                            <Button Style="{StaticResource PillButton}" x:Name="MoveDownButton" Grid.Column="1" HorizontalAlignment="Stretch" ToolTipService.ToolTip="下移" Click="OnMoveDown"><FontIcon Glyph="&#xE70D;" FontSize="14" /></Button>
                        </Grid>
                        <Button Style="{StaticResource PillButton}" x:Name="RemoveButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnRemoveMembers">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE738;" FontSize="14" /><TextBlock Text="移除所选" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnDeleteGroup">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /><TextBlock Text="删除方案…" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="NoGroupText" Text="尚未创建选课方案：点击“新建方案”后，从上方课程目录加入教学班"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
