<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>JiaoWoXuan</RootNamespace>
    <AssemblyName>JiaoWoXuan</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包(unpackaged)应用:直接运行 exe,不需要 MSIX 与开发者模式。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>交我选</Product>
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WindowsSdkBuildToolsVersion)" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="$(NotifyIconVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JiaoWoXuan.Core\JiaoWoXuan.Core.csproj" />
  </ItemGroup>

</Project>
