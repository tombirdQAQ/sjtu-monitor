<Window
    x:Class="JiaoWoXuan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="交我选">

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏:内容延伸进标题栏,配合 Mica 背景。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.ico" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="交我选" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleStatus" Grid.Column="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="StartingText" Grid.Row="1" Text="正在启动后端服务…" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel x:Name="FailurePanel" Grid.Row="1" Visibility="Collapsed" MaxWidth="560" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE7BA;" FontSize="40" HorizontalAlignment="Center" />
            <TextBlock Text="后端服务不可用" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="FailureText" TextWrapping="Wrap" IsTextSelectionEnabled="True" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button Style="{StaticResource PillButton}" Content="重新启动后端" HorizontalAlignment="Center" Click="OnRestartBackend" />
        </StackPanel>

        <Frame x:Name="OnboardingFrame" Grid.Row="1" Visibility="Collapsed" />

        <NavigationView x:Name="Nav" Grid.Row="1" Visibility="Collapsed"
                        IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" OpenPaneLength="260"
                        PaneOpening="OnPaneOpening" PaneClosing="OnPaneClosing" DisplayModeChanged="OnDisplayModeChanged"
                        IsSettingsVisible="True" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="工作台" />
                <NavigationViewItem Content="总览" Tag="Overview">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CoursesNavItem" Content="课程方案" Tag="Courses">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="自动换课" Tag="Swap">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="数据" />
                <NavigationViewItem Content="监控快照" Tag="Snapshot">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="Logs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterPanel" Padding="16,8,16,12" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="MonitorDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock x:Name="MonitorStateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="TermText" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="OnceButton" Style="{StaticResource PillButton}" Padding="10,6" ToolTipService.ToolTip="单次检查 (Ctrl+Shift+O)" Click="OnRunOnce">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button x:Name="MonitorButton" Style="{StaticResource AccentPillButton}" Click="OnToggleMonitor" />
                        <Button Style="{StaticResource PillButton}" Padding="10,6" ToolTipService.ToolTip="刷新 (F5)" Click="OnRefresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Frame x:Name="ContentFrame" />
                <ProgressBar x:Name="TaskProgress" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <tb:TaskbarIcon x:Name="TrayIcon" ContextMenuMode="PopupMenu" Grid.Row="1" Visibility="Visible" ToolTipText="交我选"
                        IconSource="ms-appx:///Assets/AppIcon.ico" NoLeftClickDelay="True"
                        LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem x:Name="TrayStatusItem" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="单次检查" Command="{x:Bind RunOnceCommand}" />
                    <MenuFlyoutItem x:Name="TrayMonitorItem" Text="开始持续监控" Command="{x:Bind ToggleMonitorCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="打开交我选" Command="{x:Bind ShowWindowCommand}" />
                    <MenuFlyoutItem Text="退出" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
