<Project>
  <!-- ng Windows 客户端共用的依赖版本。 -->
  <PropertyGroup>
    <!-- 发布版本,须与 package.json 一致(scripts/check-release-version.mjs 校验)。 -->
    <Version>1.0.0</Version>
    <WindowsAppSdkVersion>2.4.0</WindowsAppSdkVersion>
    <WindowsSdkBuildToolsVersion>10.0.28000.2705</WindowsSdkBuildToolsVersion>
    <NotifyIconVersion>2.*</NotifyIconVersion>
  </PropertyGroup>
</Project>
